# Copy this file to .env and fill in your local secrets.

# Azure Speech. Region-based config is safest; leave endpoint empty unless you
# know you need a full Speech endpoint URL.
AZURE_SPEECH_KEY= 
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_USE_ENDPOINT=false
AZURE_SPEECH_ENABLE_STYLES=false
AZURE_SPEECH_MAX_SSML_CHARS=4500

# Generic OpenAI-compatible provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_BASE=
OPENAI_MODEL=

# BigModel/Zhipu GLM OpenAI-compatible endpoint.
BIGMODEL_API_KEY=
BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
BIGMODEL_MODEL=glm-4-flash

# DeepSeek-compatible OpenAI SDK setup.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

NOVEL_TTS_HOME=.
NOVEL_TTS_OUTPUT_DIR=output
NOVEL_TTS_CACHE_DIR=cache
NOVEL_TTS_REGISTRY_PATH=cache/characters.json
NOVEL_TTS_LANGUAGE=zh-CN
NOVEL_TTS_NARRATOR_GENDER=male
NOVEL_TTS_INPUT_PATH=documents/sanguoyanyi.epub
NOVEL_TTS_INPUT_ENCODING=auto
NOVEL_TTS_CHAPTER_LIMIT=2
NOVEL_TTS_CHAPTER_MIN_CHARS=500
NOVEL_TTS_BACKEND=edge
NOVEL_TTS_PROGRESS_MANIFEST_PATH=output/generation_progress.json
NOVEL_TTS_RESUME=true

NOVEL_TTS_TARGET_CHARS=850
NOVEL_TTS_MIN_CHARS=600
NOVEL_TTS_MAX_CHARS=1000
NOVEL_TTS_PREFIX_CONTEXT_CHARS=200
NOVEL_TTS_CARRY_CONTEXT_CHARS=300
NOVEL_TTS_CHARACTER_PREPASS=true
NOVEL_TTS_CHARACTER_PREPASS_CHARS=30000
NOVEL_TTS_SYNTH_WORKERS=1
NOVEL_TTS_RETRY_MAX_ATTEMPTS=4
NOVEL_TTS_RETRY_BASE_DELAY=1.0
NOVEL_TTS_RETRY_MAX_DELAY=30.0
NOVEL_TTS_RATE_LIMIT_PER_MINUTE=0
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=1.0
LLM_RETRY_MAX_DELAY=20.0
LLM_RATE_LIMIT_PER_MINUTE=0
NOVEL_TTS_TARGET_DBFS=-18.0
NOVEL_TTS_INTER_CHUNK_SILENCE_MS=250
NOVEL_TTS_SPEAKER_BREAK_MS=300
NOVEL_TTS_AUDIO_CROSSFADE_MS=0
NOVEL_TTS_DYNAMIC_PAUSES=true
NOVEL_TTS_BGM_PATH=
NOVEL_TTS_BGM_GAIN_DB=-24.0

EDGE_TTS_DEFAULT_VOICE=zh-CN-XiaoxiaoNeural
EDGE_TTS_VOICE_MAP={"zh-CN-YunxiNeural":"zh-CN-YunxiNeural","zh-CN-XiaoxiaoNeural":"zh-CN-XiaoxiaoNeural","zh-CN-YunjieNeural":"zh-CN-YunjieNeural","zh-CN-XiaoyiNeural":"zh-CN-XiaoyiNeural","zh-CN-YunzeNeural":"zh-CN-YunzeNeural"}
